{
  "name": "bumi-bloom",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:storefront": "npm run dev -w apps/storefront",
    "dev:admin": "npm run dev -w apps/admin",
    "build:storefront": "npm run build -w apps/storefront",
    "build:admin": "npm run build -w apps/admin",
    "typecheck:storefront": "npm run typecheck -w apps/storefront",
    "typecheck:admin": "npm run typecheck -w apps/admin",
    "db:generate": "npm run generate -w packages/db",
    "db:push": "npm run push -w packages/db"
  },
  "engines": {
    "node": ">=20"
  }
}
