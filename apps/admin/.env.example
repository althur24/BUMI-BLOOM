# apps/admin — server-only environment (RAHASIA, jangan commit).
# Copy to .env.local and fill real values.

# ── Shopify Admin API (client credentials grant) ───────────────────────────
SHOPIFY_SHOP=<your-shop>
SHOPIFY_CLIENT_ID=<custom-app-client-id>
SHOPIFY_CLIENT_SECRET=<custom-app-client-secret>
SHOPIFY_API_VERSION=2026-10
SHOPIFY_STOREFRONT_TOKEN=<storefront-public-token>
# Required scopes for checkout: read_discounts, read_draft_orders,
# write_draft_orders, write_orders (plus the existing order/product scopes).

# ── Supabase (service role — SERVER ONLY, bypasses RLS) ─────────────────────
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Anon key — public, but read at RUNTIME on the server (injected into the client
# via app/layout.tsx window.__PUBLIC_ENV__). Required for the login UI.
SUPABASE_ANON_KEY=<anon-key>
# Browser (anon) key — public, safe to expose. Used by the login page.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Prisma (Supabase Postgres pooler) ───────────────────────────────────────
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.supabase.com:5432/postgres?schema=public"

# ── Storefront (CORS origin for public /api/subscribe endpoint) ──────────────
# The storefront origin that is allowed to call the public subscribe endpoint.
# Dev: http://localhost:3000  ·  Prod: https://www.bumibloom.com
STOREFRONT_URL=http://localhost:3000

# ── Stripe checkout (Fase 1) ────────────────────────────────────────────────
# Dev/staging: sk_test_…  ·  Production: sk_live_…
# In production a test key is rejected at startup unless ALLOW_TEST_KEYS=true.
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>
STRIPE_CHECKOUT_MODE=stripe
# Optional comma-separated override of accepted payment methods (e.g. card).
# Leave empty to use Stripe defaults (wallet methods are derived automatically).
STRIPE_PAYMENT_METHODS=
# Optional: create a 10% inclusive AU GST tax rate in Stripe and paste its id.
# If empty, the app creates one on first checkout.
STRIPE_GST_TAX_RATE_ID=
# Shopify location id used to restock inventory when a full refund happens.
SHOPIFY_INVENTORY_LOCATION_ID=
# Escape hatch: allow a test-mode Stripe key while NODE_ENV=production.
# Only set this on staging deployments that run with NODE_ENV=production.
ALLOW_TEST_KEYS=

# ── Server-side purchase analytics (optional) ───────────────────────────────
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# ── Order tracking page ─────────────────────────────────────────────────────
# HMAC secret for /order/<token>. Generate with: openssl rand -hex 32
# Admin only — the storefront never sees this.
TRACKING_TOKEN_SECRET=

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── AI enrichment (optional — Fase 5) ───────────────────────────────────────
# If set, the import pipeline enriches titles/descriptions (translate ID→EN,
# SEO copy, category suggestion) via Google Gemini. If unset, only rule-based
# cleaning runs (always safe).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# IDR → AUD conversion rate (1 AUD = X IDR). Default 10000.
# Scraped IDR prices are auto-converted before preview + push to Shopify.
IDR_TO_AUD_RATE=10000

# ── Queue hardening (optional — Fase 5) ──────────────────────────────────────
# If set, the import worker uses BullMQ + Redis (retry/concurrency/persistence).
# If unset, an in-process FIFO + DB-backed recovery is used (default, fine for
# low–moderate volume).
REDIS_URL=

# ── Affiliate API fallback (optional — Fase 5) ───────────────────────────────
# Official Shopee/Tokopedia affiliate APIs — the stable path when headless
# scraping is blocked by anti-bot. Requires partnership approval.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
TOKPED_AFFILIATE_TOKEN=

# ── GA4 visitor analytics (optional — Fase 5) ───────────────────────────────
# Shopify Admin API does NOT expose visitor/session counts. For independent
# visitor analytics: (1) fill GA_ID in storefront apps/storefront/js/analytics.js,
# (2) create a GA4 Data API service account, (3) set these and build a GA4 route.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
