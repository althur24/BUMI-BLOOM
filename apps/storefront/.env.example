# Storefront — public environment (browser-safe values only).

NEXT_PUBLIC_SHOPIFY_SHOP=<shop>
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=<storefront-public-token>
NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-10

# Stripe checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
NEXT_PUBLIC_CHECKOUT_MODE=stripe
NEXT_PUBLIC_CHECKOUT_API_URL=http://localhost:4001

# ── Analytics (browser-side, public IDs — safe to expose) ───────────────────
# Leave empty to keep tracking dormant (events log to console in dev).
# GA4: Google Analytics > Admin > Data Streams > your web stream,
#      copy the "Measurement ID" (starts with G-).
# Meta: Meta Events Manager > Data Sources > your Pixel, copy the "Dataset ID".
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
